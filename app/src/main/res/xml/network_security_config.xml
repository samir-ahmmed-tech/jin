<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- By default, disallow all cleartext HTTP traffic across the app -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Permit cleartext HTTP ONLY for local loopback services (Termux daemon, AgyBridge, Browser MCP, Local Dev Server) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
